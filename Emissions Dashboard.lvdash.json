{
  "datasets": [
    {
      "name": "36b40a8b",
      "displayName": "Location Data",
      "queryLines": [
        "SELECT latitude,\r\n",
        "longitude, \r\n",
        "`GHG emissions mtons CO2e` AS Emissions\r\n",
        "FROM emissions_data"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "118e3449",
      "displayName": "Emissions per person",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       CAST(\r\n",
        "         REPLACE(\r\n",
        "           `GHG emissions mtons CO2e`,\r\n",
        "           ',',\r\n",
        "           ''\r\n",
        "         ) AS DOUBLE\r\n",
        "       ) / CAST(\r\n",
        "         REPLACE(\r\n",
        "           population,\r\n",
        "           ',',\r\n",
        "           ''\r\n",
        "         ) AS DOUBLE\r\n",
        "       ) AS emissions_per_person\r\n",
        "FROM emissions_data\r\n",
        "ORDER BY emissions_per_person DESC"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "b608e6c2",
      "displayName": "Total Emission per state",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "       SUM(CAST(\r\n",
        "         REPLACE( `GHG emissions mtons CO2e`,',','')\r\n",
        "          AS DOUBLE\r\n",
        "       ))AS Total_Emission\r\n",
        "FROM emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_Emission DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "3ee9b0cc",
      "displayName": "Total Emissions by mTon C02e",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "       population,\r\n",
        "       CAST(\r\n",
        "         REPLACE(`GHG emissions mtons CO2e`, ',' ,'') AS DOUBLE) AS total_emissions\r\n",
        "FROM emissions_data\r\n",
        "ORDER BY total_emissions DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
